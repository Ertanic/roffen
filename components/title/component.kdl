component "Title" {
    lang-key "components-title"

    property "content" {
        lang-key "components-title-property-content"
        default "title"
    }

    (number)property "level" {
        lang-key "components-title-property-level"
        default "1"
        min "1"
        max "6"
    }

    html "h#level" {
        attr "class" "component-title"
        children {
            content "#content"
        }
    }
}